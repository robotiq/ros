<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotiq_controllers</name>
  <version>1.1.0</version>
  <description>Controllers for the Robotiq gripper.</description>
  <maintainer email="noreply@robotiq.com">Robotiq</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/robotiq/ros</url>
  <url type="bugtracker">https://github.com/robotiq/ros/issues</url>
  <author>Cory Crean</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <!-- The gripper action controller derives from parallel_gripper_controller;
       Humble has only its predecessor, from which GripperCommandController derives.
       Humble EOL: simplify — delete the gripper_controllers line and the
       condition on the other. -->
  <depend condition="$ROS_DISTRO != humble">parallel_gripper_controller</depend>
  <depend condition="$ROS_DISTRO == humble">gripper_controllers</depend>
  <depend>realtime_tools</depend>
  <!-- Headers only, for the SDK's status enums it ships. -->
  <depend>robotiq_driver</depend>
  <depend>robotiq_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tinyxml2_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclcpp_action</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
