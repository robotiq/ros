<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotiq_controllers</name>
  <version>1.1.0</version>
  <description>Controllers for the Robotiq gripper.</description>
  <maintainer email="noreply@robotiq.com">Robotiq</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/robotiq/ros</url>
  <url type="bugtracker">https://github.com/robotiq/ros/issues</url>
  <author>Cory Crean</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <!-- The gripper action controller derives from it; Humble has no such package.
       Humble EOL: simplify — drop the condition. -->
  <depend condition="$ROS_DISTRO != humble">parallel_gripper_controller</depend>
  <depend>realtime_tools</depend>
  <depend>robotiq_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>hardware_interface</test_depend>
  <test_depend>rclcpp_action</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
